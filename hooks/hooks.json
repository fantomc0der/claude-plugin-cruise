{
  "description": "cruise: the Stop hook keeps an active run going; the prompt and session-start hooks tell the model how a message or a fresh session relates to it. All three read .cruise/run.json and print nothing when no run is active.",
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/cruise",
              "hook",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/cruise",
              "hook",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/cruise",
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
